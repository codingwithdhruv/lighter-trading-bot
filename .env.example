# --- Lighter Settings ---
# Lighter RPC URL (Mainnet)
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai
# Your Lighter integer account index (find it in UI or via API)
LIGHTER_ACCOUNT_INDEX=722983
# Your Lighter API key index (usually 0)
LIGHTER_API_KEY_INDEX=0
# Your Lighter Ethereum-based private key (0x...)
LIGHTER_PRIVATE_KEY=0xyour_lighter_private_key

# --- Telegram Settings ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=789456:ABC-DEF
# List of allowed Telegram User IDs (comma separated)
ALLOWED_TELEGRAM_USER_IDS=12345678,98765432

# --- Operational Settings ---
# Frequency to check candlesticks and orders (seconds)
POLL_INTERVAL_SEC=15
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Max slippage for 5m candle close triggers (points)
MAX_TRIGGER_SLIPPAGE=150.0
# Bybit WebSocket URL (SPOT)
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/spot

# --- Pacifica Copy Trading ---
# Your Pacifica API Agent Key
PACIFICA_API_KEY=your_pacifica_agent_key
# Your Pacifica subaccount address (optional, leave blank for main)
PACIFICA_SUBACCOUNT=

# --- Decibel Copy Trading ---
# Decibel uses a three-tier account model:
#   1. Primary Wallet  — your main wallet (creates API Wallet on app.decibel.trade/api)
#   2. API Wallet      — signs all transactions. Derived from DECIBEL_PRIVATE_KEY.
#   3. Trading Account — holds USDC. This is DECIBEL_SUBACCOUNT.
#
# Your API Wallet private key from app.decibel.trade/api → "Create API Wallet"
# Paste EXACTLY as copied (either "ed25519-priv-0x..." or "0x..." — both work)
DECIBEL_PRIVATE_KEY=ed25519-priv-0x...
#
# Both keys below come from Geomi (https://geomi.dev):
#
# Geomi Client API Key (REQUIRED) — used as Bearer token for fullnode auth
# Created under: Geomi → Project → Add "API Key" resource → Copy "Key secret"
DECIBEL_NODE_API_KEY=your_geomi_client_api_key
#
# Geomi Gas Station API Key (OPTIONAL but recommended)
# If set: transactions are gas-free, no APT needed at your API Wallet.
# If not set: you must deposit APT to your API Wallet address for gas.
# Created under: Geomi → Project → Add "Gas Station" resource → Copy key
DECIBEL_GAS_STATION_KEY=
#
# Your Trading Account (Subaccount) address — found at app.decibel.trade
DECIBEL_SUBACCOUNT=0x...
