# --- Lighter Settings ---
# Lighter RPC URL (Mainnet)
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai
# Your Lighter integer account index (find it in UI or via API)
LIGHTER_ACCOUNT_INDEX=722983
# Your Lighter API key index (usually 0)
LIGHTER_API_KEY_INDEX=0
# Your Lighter Ethereum-based private key (0x...)
LIGHTER_PRIVATE_KEY=0xyour_lighter_private_key

# --- Telegram Settings ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=789456:ABC-DEF
# List of allowed Telegram User IDs (comma separated)
ALLOWED_TELEGRAM_USER_IDS=12345678,98765432

# --- Operational Settings ---
# Frequency to check candlesticks and orders (seconds)
POLL_INTERVAL_SEC=15
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Max slippage for 5m candle close triggers (points)
MAX_TRIGGER_SLIPPAGE=150.0
# Bybit WebSocket URL (SPOT)
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/spot

# --- Pacifica Copy Trading ---
# Your Pacifica API Agent Key
PACIFICA_API_KEY=your_pacifica_agent_key
# Your Pacifica subaccount address (optional, leave blank for main)
PACIFICA_SUBACCOUNT=

# --- Decibel Copy Trading ---
# Your API Wallet private key (ed25519-priv-0x... or raw hex)
DECIBEL_PRIVATE_KEY=ed25519-priv-0x...
# Your Decibel Node API Key (Bearer Token)
DECIBEL_NODE_API_KEY=your_decibel_node_api_key
# Your Decibel Trading Account (Subaccount) address (Mandatory)
DECIBEL_SUBACCOUNT=0x...
